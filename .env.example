# Termly API credentials — copy to .env and fill in. .env is git-ignored.
# Used only by scripts/termly.mjs on your Mac. Never ship these to the browser.
#
# Public and private API keys (Termly partner API). Find or request them in Termly
# (Termly issues partner API keys; see https://docs.termly.io/introduction/authentication/).
TERMLY_PUBLIC_KEY=
TERMLY_PRIVATE_KEY=

# Account and website IDs (look like acct_... and web_...).
TERMLY_ACCOUNT_ID=
TERMLY_WEBSITE_ID=

# Website UUID used in the public embed snippet. Not secret; it appears in page source.
# `node scripts/termly.mjs website` prints it.
TERMLY_WEBSITE_UUID=

# Optional: override the API host (Termly provides test accounts on request).
# TERMLY_API_BASE=https://api.termly.io
